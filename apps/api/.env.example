# WARDEN API authentication
# Generate a unique random token of at least 32 characters.
WARDEN_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Reviewer identity recorded in approval audit events.
WARDEN_REVIEWER=WARDEN Operator

# Local development configuration
PORT=3001
WEB_ORIGIN=http://localhost:5173

# NEAR Testnet transaction finality verification (server-side only)
NEAR_TESTNET_TX_RPC_URL=https://archival-rpc.testnet.fastnear.com
